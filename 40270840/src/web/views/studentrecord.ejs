<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Record</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/ui.css">
</head>

<body>
    <nav class="navbar2">
        <div class="logo-container">
            <img src="/media/logo.png" alt="Logo">
        </div>
        <div class="logout-container">
            <a href="/login" class="button">Logout</a>
        </div>
    </nav>

    <div class="container2 py-4">


        <div class="mb-4">

            <h4>Student Record</h4>

        </div>



        <div class="row g-4">
            <div class="col-12">

                <div class="card shadow-sm bg-white">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Classification Details</strong>
                        <button type="button" id="editToggleButton" class="btn btn-primary btn-sm" onclick="toggleEditMode('classificationForm', this)">
                    <i class="bi bi-pencil"></i> Edit details
                </button>
                       
                    </div>
                    <div class="card-body">
                        <form id="studentForm" action="/officer/viewstudents/<%= programme_id %>/<%= student.id %>"
                            method="POST">
                            <fieldset id="classificationForm" disabled>

                                <div class="row">
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Review Status</label>
                                        <select class="form-select" name="cohort_year">
                                            <option value="Approved" <%=student.review_status==='Approved' ? 'selected'
                                                : '' %>>Approved</option>
                                            <option value="Awaiting Approval"
                                                <%=student.review_status==='Awaiting Approval' ? 'selected' : '' %>
                                                >Awaiting Approval</option>
                                            <option value="Manual Review Required" <%=student.review_status==='Flagged'
                                                ? 'selected' : '' %>>Manual Review Required</option>
                                        </select>
                                    </div>



                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Classification Mark</label>
                                        <input type="text" name="classification_mark" class="form-control"
                                            value="<%= result.totalAverage %>">
                                    </div>



                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Classification</label>
                                        <select class="form-select" name="cohort_year">
                                            <option value="First Class Honours (1st)"
                                                <%=result.proposed_classification==='First Class Honours (1st)'
                                                ? 'selected' : '' %>>First Class Honours (1st)</option>
                                            <option value="Upper Second Class Honours (2:1)"
                                                <%=result.proposed_classification==='Upper Second Class Honours (2:1)'
                                                ? 'selected' : '' %>>Upper Second Class Honours (2:1)</option>
                                            <option value="Lower Second Class Honours (2:2)"
                                                <%=result.proposed_classification==='Lower Second Class Honours (2:2)'
                                                ? 'selected' : '' %>>Lower Second Class Honours (2:2)</option>
                                            <option value="Third Class Honours (3rd)"
                                                <%=result.proposed_classification==='Third Class Honours (3rd)'
                                                ? 'selected' : '' %>>Third Class Honours (3rd)</option>
                                            <option value="Fail" <%=result.proposed_classification==='Fail' ? 'selected'
                                                : '' %>>Fail</option>
                                        </select>
                                    </div>



                                    <div class="col-md-3 mb-3">
                                        <label class="form-label">Manual Override</label>
                                        <select class="form-select" name="manual_override">
                                            <option value="Yes" <%=student.is_manual_override===1 ? 'selected' : '' %>
                                                >Yes</option>
                                            <option value="No" <%=student.is_manual_override===0 ||
                                                student.is_manual_override==='NULL' ? 'selected' : '' %>>No</option>

                                        </select>
                                    </div>
                                </div>


                                <div class="mb-3">
                                    <label class="form-label">Reason For Flag</label>

                                    <% let flagValue="Not Applicaple" ; if (result.isBorderline){
                                        flagValue="Mark is borderline: Manual Review Required" ; } else if
                                        (student.mitigating_circumstances==1 || student.mitigating_circumstances==true){
                                        flagValue="Student has mitigating circumstances. Manual Review Required" ; } %>

                                        <input type="text" name="flag_reason" class="form-control"
                                            value="<%= flagValue %>" readonly>
                                </div>


                                <div class="mb-3">
                                    <label class="form-label">Decision Rationale</label>
                                    <textarea name="rationale" class="form-control"
                                        rows="4"><%- (student.rationale) ? student.rationale :(result.isBorderline) ? "Candidate is in borderline range and flagged for manual review. Final decision based on [Insert board decision]." :(student.mitigating_circumstances) ? "Candidate has mitigating circumstances and is flagged for manual review. Final decision based on [Insert board decision]." :"Classification automatically calculated based on academic performance and credit achievement. No manual override required."_%></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary">Save Changes</button>


                            </fieldset>

                        </form>

                    </div>
                </div>
            </div>




            <div class="col-md-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between"></div>
                    <strong>Student Personal Details</strong>
                    <button type="button" id="editToggleButton" class="btn btn-primary"
                        onclick="toggleEditMode('detailsForm', this)">
                        Edit details
                    </button>
                </div>
                <div class="card-body">
                    <form id="studentForm" action="/officer/viewstudents/<%= programme_id %>/<%= student.id %>"
                        method="POST">
                        <fieldset id="detailsForm" disabled>

                            <div class="mb-3">
                                <label class="form-label">Student Number</label>
                                <input type="text" name="student_number" class="form-control"
                                    value="<%= student.student_number %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">First Name</label>
                                <input type="text" name="first_name" class="form-control"
                                    value="<%= student.first_name %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Last Name</label>
                                <input type="text" name="last_name" class="form-control"
                                    value="<%= student.last_name %>">
                            </div>

                            <div class="mb-3">
                                <p class="card-text">Programme: <%= rules[0].award_type %>
                                        <%= rules[0].programme_name %> (<%= rules[0].pathway %>)</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Cohort Year</label>
                                <select class="form-select" name="cohort_year">
                                    <option value="2026/2027" <%=student.cohort_year==='2026/2027' ? 'selected' : '' %>
                                        >2026/2027</option>
                                    <option value="2025/2026" <%=student.cohort_year==='2025/2026' ? 'selected' : '' %>
                                        >2025/2026</option>
                                    <option value="2024/2025" <%=student.cohort_year==='2024/2025' ? 'selected' : '' %>
                                        >2024/2025</option>
                                    <option value="2023/2024" <%=student.cohort_year==='2023/2024' ? 'selected' : '' %>
                                        >2023/2024</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mitigating Circumstances</label>
                                <select class="form-select" name="mitigating_circumstances">
                                    <option value="Yes" <%=student.mitigating_circumstances===1 ? 'selected' : '' %>>Yes
                                    </option>
                                    <option value="No" <%=student.mitigating_circumstances===0 ? 'selected' : '' %>>No
                                    </option>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-primary">Save Changes</button>


                        </fieldset>

                    </form>

                </div>
            </div>




            <div class="col-md-8">

                <div class="card shadon-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Academic Record</strong>
                        <button type="button" id="editToggleButton" class="btn btn-primary ms-3"
                            onclick="toggleEditMode('marksForm', this)">
                            <i class="bi bi-pencil"></i> Edit details
                        </button>
                    </div>
                    <div class="card-body">
                        <form id="studentForm" action="/officer/viewstudents/<%= programme_id %>/<%= student.id %>"
                            method="POST">
                            <fieldset id="marksForm" disabled>

                                <h6 class="text-muted border-bottom pb-2">Level 1</h6>

                                <div class="table-responsive mb-4">
                                    <table class="table table-sm table-bordered table-hover">

                                        <thead>
                                            <tr>
                                                <th scope="col">Module Code</th>
                                                <th scope="col">Module Name</th>
                                                <th scope="col">Credits</th>
                                                <th scope="col">Mark</th>
                                                <th scope="col">Resit</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% result.level1Grades.forEach((grade)=> { %>
                                                <tr>
                                                    <td>
                                                        <%= grade.module_code %>
                                                    </td>

                                                    <td>
                                                        <%= grade.module_name %>
                                                    </td>

                                                    <td>
                                                        <%= grade.credits %>
                                                    </td>

                                                    <td>
                                                        <input type="text" name="mark" class="form-control"
                                                            value="<%= grade.mark %>">
                                                    </td>

                                                    <% if (grade.is_resit==1){ %>

                                                        <td>
                                                            Yes
                                                        </td>

                                                        <%} else if (grade.is_resit==0){ %>
                                                            <td>
                                                                No
                                                            </td>
                                                            <%}%>
                                                </tr>


                                                <%})%>
                                        </tbody>



                                    </table>
                                </div>



                                <h6 class="table-muted border-bottom pb-2">Level 2</h6>

                                <div class="table-responsive mb-4">
                                    <table class="table table-sm table-bordered table-hover">

                                        <thead>
                                            <tr>
                                                <th scope="col">Module Code</th>
                                                <th scope="col">Module Name</th>
                                                <th scope="col">Credits</th>
                                                <th scope="col">Mark</th>
                                                <th scope="col">Resit</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% result.level2Grades.forEach((grade)=> { %>
                                                <tr>
                                                    <td>
                                                        <%= grade.module_code %>
                                                    </td>

                                                    <td>
                                                        <%= grade.module_name %>
                                                    </td>

                                                    <td>
                                                        <%= grade.credits %>
                                                    </td>

                                                    <td>
                                                        <input type="text" name="mark" class="form-control"
                                                            value="<%= grade.mark %>">
                                                    </td>

                                                    <% if (grade.is_resit==1){ %>

                                                        <td>
                                                            Yes
                                                        </td>

                                                        <%} else if (grade.is_resit==0){ %>
                                                            <td>
                                                                No
                                                            </td>
                                                            <%}%>
                                                </tr>


                                                <%})%>
                                        </tbody>



                                    </table>

                                </div>



                                <h6 class="text-muted border-bottom pb-2">Level 3</h6>

                                <div class="table-responsive mb-4">
                                    <table class="table table-sm table-bordered table-hover">

                                        <thead>
                                            <tr>
                                                <th scope="col">Module Code</th>
                                                <th scope="col">Module Name</th>
                                                <th scope="col">Credits</th>
                                                <th scope="col">Mark</th>
                                                <th scope="col">Resit</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% result.level3Grades.forEach((grade)=> { %>
                                                <tr>
                                                    <td>
                                                        <%= grade.module_code %>
                                                    </td>

                                                    <td>
                                                        <%= grade.module_name %>
                                                    </td>

                                                    <td>
                                                        <%= grade.credits %>
                                                    </td>

                                                    <td>
                                                        <input type="text" name="mark" class="form-control"
                                                            value="<%= grade.mark %>">
                                                    </td>

                                                    <% if (grade.is_resit==1){ %>

                                                        <td>
                                                            Yes
                                                        </td>

                                                        <%} else if (grade.is_resit==0){ %>
                                                            <td>
                                                                No
                                                            </td>
                                                            <%}%>
                                                </tr>


                                                <%})%>
                                        </tbody>



                                    </table>

                                </div>




                                <button type="submit" class="btn btn-primary">Save Changes</button>


                            </fieldset>

                        </form>

                    </div>
                </div>



            </div>


        </div>



    </div>

    </div>
    </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>

        function toggleEditMode(targetId, btn) {
            const fieldset = document.getElementById(targetId);


            const isCurrentlyCisabled = fieldset.hasAttribute('disabled');

            if (isCurrentlyCisabled) {
                fieldset.removeAttribute('disabled');
                btn.innerText = 'Cancel';
            } else {
                if (confirm("Discard unsaved changes?")) {
                    location.reload();
                }
            }
        }

    </script>

</body>

</html>