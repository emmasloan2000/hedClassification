<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/ui.css">
</head>

<body>
    <nav class="navbar2">
        <div class="logo-container">
            <img src="/media/logo.png" alt="Logo">
        </div>
        <div class="logout-container">
            <a href="/login" class="button">Logout</a>
        </div>
    </nav>

    <div class="container2 min-vh-100 d-flex flex-column">
        <div class="row">
            <div class="col-md-10 col-sm-10">

                <div class="card bg-custom-brand">
                    <h5 class="card-header display-6">Add Grades for <%= student.first_name %>
                            <%= student.last_name %></h5>
                                <div class="card-body">
                                    <form action="/officer/addstudentgrades/<%=programme_id%>/<%=student_id%>"
                                        method="POST">
                                        <div class="table-responsive mb-4">
                                            <table class="table table-sm table-bordered table-hover">

                                                <thead>
                                                    <tr>
                                                        <th scope="col"></th>
                                                        <th scope="col">Level</th>
                                                        <th scope="col">Module Code</th>
                                                        <th scope="col">Module Name</th>
                                                        <th scope="col">Credits</th>
                                                        <th scope="col">Mark</th>
                                                        <th scope="col">Resit</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% modules.forEach((module)=> { %>
                                                        <tr>
                                                            <td>
                                                                <input type="checkbox" name="module_checkbox" value="<%=module.module_code%>">
                                                            </td>
                                                              <td>
                                                                <%= module.level %>
                                                            </td>
                                                            <td>
                                                                <%= module.module_code %>
                                                            </td>

                                                            <td>
                                                                <%= module.module_name %>
                                                            </td>

                                                            <td>
                                                                <%= module.credits %>
                                                            </td>

                                                            <td>
                                                             
                                                                <input type="number" name="mark_<%=module.module_code%>" class="form-control"
                                                                min="0" max="100" step="0.2" placeholder="0.00"
                                                                   >

                                                            </td>

                                                            <td>
                                                                <select name="resit_<%=module.module_code%>"
                                                                    class="form-select form-select-sm">
                                                                    <option value="1" 
                                                                        >Yes</option>
                                                                    <option value="0" 
                                                                        >No</option>
                                                                </select>
                                                            </td>
                                                        </tr>


                                                        <%})%>
                                                </tbody>



                                            </table>
                                        </div>

                                        <button type="submit" class="btn btn-primary">Save</button>

                                    </form>
                                </div>
                </div>
            </div>
        </div>



</body>

</html>