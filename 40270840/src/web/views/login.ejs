<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/ui.css">

</head>

<body>

    <nav class="navbar fixed-top bg-transparent">
        <div class="container">
            <a class="navbar-brand" href="#">
                <img src="/media/logo.png" alt="Logo">
            </a>
        </div>
    </nav>

    <div class="hero d-flex align-items-center justify-content-center">
        <div class="container">
            <div class="row">
                <div class="col-11 col-md-5 col-lg-4"></div>
                <div class="col-11 col-md-5 col-lg-4">

                    <div class="login-card shadoow-lg p-4">
                        <h1 class="text-center mb-4">Welcome to Queen's University Belfast classification manager
                            Please enter your username and password.
                        </h1>

                    <form action="/login" method="POST" class="d-flex flex-column align-items-center">
                        <div class="input-group vertical">
                            <input name="userF" type="text" placeholder="username"/>
                        </div>
                        <div class="input-group vertical">
                            <input name="passF" type="text" placeholder="password"/>
                        </div>
                        <button class="login-btn">Login</button>
                    </form>
                </div>
                <div class="col-11 col-md-5 col-lg-4"></div>
            </div>
            </div>

              </div>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                    crossorigin="anonymous"></script>

</body>

</html>