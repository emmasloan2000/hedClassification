<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Programme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/ui.css">
</head>

<body>
    <%- include('partials/navbar') %>

        <div class="container2">
            <div class="row">
                <div class="col-lg-6 col-xl-6 mx-auto">

                    <div class="form-container">

                        <h4>Edit Degree programme</h4>


                        <form action="/admin/programmeinfo/<%= programme.programme_id %>" method="POST">

                            <div class="mb-4">
                                <label for="programme_name" class="form-label">Programme title</label>
                                <input type="text" name="programme_name" class="form-control" id="programme_name"
                                    value="<%= programme.programme_name %>">
                            </div>
                            <div class="mb-4">
                                <label for="award_type" class="form-label">Award Type</label>
                                <select class="form-select" name="award_type" aria-label="Default select example">
                                    <option value="BA" <%=programme.award_type==='BA' ? 'selected' : '' %>>BA</option>
                                    <option value="BSc" <%=programme.award_type==='BSc' ? 'selected' : '' %>>BSc
                                    </option>
                                    <option value="BEng" <%=programme.award_type==='BEng' ? 'selected' : '' %>>BEng
                                    </option>
                                    <option value="LLB" <%=programme.award_type==='LLB' ? 'selected' : '' %>>LLB
                                    </option>
                                    <option value="BEd" <%=programme.award_type==='BEd' ? 'selected' : '' %>>BEd
                                    </option>
                                    <option value="BArch" <%=programme.award_type==='BArch' ? 'selected' : '' %>>BArch
                                    </option>
                                </select>
                            </div>
                            <div class="mb-4">
                                <label for="pathway" class="form-label">Pathway</label>
                                <input type="text" name="pathway" class="form-control" id="pathway"
                                    value="<%= programme.pathway %>">
                            </div>
                            <div class="mb-4">
                                <label for="academic_year" class="form-label">Academic Year</label>
                                <select class="form-select" name="academic_year" aria-label="Default select example">
                                    <option selected>Open this select menu</option>
                                    <option value="2025/2026" <%=programme.academic_year==='2025/2026' ? 'selected' : ''
                                        %>
                                        >2025/2026</option>
                                    <option value="2024/2025" <%=programme.academic_year==='2024/2025' ? 'selected' : ''
                                        %>
                                        >2024/2025</option>
                                    <option value="2023/2024" <%=programme.academic_year==='2023/2024' ? 'selected' : ''
                                        %>
                                        >2023/2024</option>
                                </select>
                            </div>
                            <div class="row">
                                <h6>Yearly weightings (Decimals)</h6>
                                <div class="row">
                                    <div class="col-12 col-sm-4">
                                        <label class="small text-muted">Year 1</label>
                                        <input type="number" name="y1_weight" step="0.01" min="0" max="1"
                                            class="form-control" value="<%= programme.y1_weight %>">
                                    </div>
                                    <div class="col-12 col-sm-4">
                                        <label class="small text-muted">Year 2</label>
                                        <input type="number" name="y2_weight" step="0.01" min="0" max="1"
                                            class="form-control" value="<%= programme.y2_weight %>">
                                    </div>
                                    <div class="col-12 col-sm-4">
                                        <label class="small text-muted">Year 3</label>
                                        <input type="number" name="y3_weight" step="0.01" min="0" max="1"
                                            class="form-control" value="<%= programme.y3_weight %>">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <h6>Minimum Marks for Honours</h6>
                                <div class="row">
                                    <div class="col-12 col-sm-3">
                                        <label class="small text-muted">1st</label>
                                        <input type="number" name="min_1st" min="0" max="100" class="form-control"
                                            value="<%= programme.min_1st %>">
                                    </div>
                                    <div class="col-12 col-sm-3">
                                        <label class="small text-muted">2:1</label>
                                        <input type="number" name="min_2_1" min="0" max="100" class="form-control"
                                            value="<%= programme.min_2_1 %>">
                                    </div>
                                    <div class="col-12 col-sm-3">
                                        <label class="small text-muted">2:2</label>
                                        <input type="number" name="min_2_2" min="0" max="100" class="form-control"
                                            value="<%= programme.min_2_2 %>">
                                    </div>
                                    <div class="col-12 col-sm-3">
                                        <label class="small text-muted">3rd</label>
                                        <input type="number" name="min_3rd" min="0" max="100" class="form-control"
                                            value="<%= programme.min_3rd %>">
                                    </div>
                                </div>
                            </div>

                            <div class="row align-items-end">
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="resit_capped"
                                            id="resit_capped" <%=programme.resit_capped ? 'checked' : '' %>>
                                        <label class="form-check-label" for="resit_capped">Resits Capped at 40%</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label for="max_failed_credits" class="form-label small fw-bold">Max Failed Credits
                                        Allowed</label>
                                    <select name="max_failed_credits_allowed" id="max_failed_credits"
                                        class="form-select">
                                        <option value="0" <%=programme.max_failed_credits_allowed==0 ? 'selected' : ''
                                            %>>0
                                            Credits</option>
                                        <option value="20" <%=programme.max_failed_credits_allowed==20 ? 'selected' : ''
                                            %>
                                            >20 Credits (1 Module)</option>
                                        <option value="40" <%=programme.max_failed_credits_allowed==40 ? 'selected' : ''
                                            %>
                                            >40 Credits</option>
                                        <option value="60" <%=programme.max_failed_credits_allowed==60 ? 'selected' : ''
                                            %>
                                            >60 Credits</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row g-3 mb-4">
                                <div class="col">
                                    <h6>Minimum Compensation Mark</h6>
                                    <input type="number" name="min_compensation_mark" min="0" max="100"
                                        class="form-control" value="<%= programme.min_compensation_mark %>">
                                </div>

                                <div class="col-md-6">
                                    <h6>Dissertation Minimum Pass Mark</h6>
                                    <input type="number" name="dissertation_min_pass" min="0" max="100"
                                        class="form-control" value="<%= programme.dissertation_min_pass %>">
                                </div>
                                <h6>Assigned Officer</h6>
                                <select name="user_id" class="form-select">
                                    <option value="">-- No Officer Assigned --</option>
                                    <% officers.forEach(item=> { %>
                                        <option value="<%= item.id %>" <%=(programme.first_name + ' ' +
                                            programme.last_name===item.first_name + ' ' + item.last_name) ? 'selected'
                                            : '' %>>
                                            <%= item.first_name %>
                                                <%= item.last_name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary" name="action" value="save">Save
                                Changes</button>
                            <button type="submit" name="action" value="delete" class="btn btn-primary float-end"
                                onclick="return confirm('Are you sure you want to archive this programme? This will hide the record but preserve history.');">Archive
                                Programme</button>

                        </form>
                    </div>
                </div>
                <div class="col-lg-6 col-xl-6 align-self-start">

                    <div class="form-container">

                        <h4>Edit Programe Modules</h4>

                        <form action="/admin/managemodules/<%= programme.programme_id %>" method="POST">

                            <div class="table-responsive mb-4">
                                <table class="table table-sm table-bordered table-hover" id="moduleTable">

                                    <thead>
                                        <tr>

                                            <th scope="col">Level</th>
                                            <th scope="col">Module Code</th>
                                            <th scope="col">Module Name</th>
                                            <th scope="col">Credits</th>
                                            <th scope="col"></th> 

                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% let rowCount=Math.max(modules.length, 18); for (let i=0; i <rowCount; i++) {
                                            let module=modules[i] || {}; %>
                                            <tr>

                                                <input type="hidden" name="module_id[]" value="<%= module.id || '' %>">


                                                <td>
                                                    <select name="level[]" class="form-select">
                                                        <option valuee="">Select Level</option>
                                                        <option value="1" <%=module.level==1 ? 'selected' : '' %>>1
                                                        </option>
                                                        <option value="2" <%=module.level==2 ? 'selected' : '' %>>2
                                                        </option>
                                                        <option value="3" <%=module.level==3 ? 'selected' : '' %>>3
                                                        </option>

                                                    </select>

                                                </td>

                                                <td>
                                                    <input type="text" name="module_code[]" class="form-control"
                                                        value="<%= module.module_code || '' %>">
                                                </td>

                                                <td>
                                                    <input type="text" name="module_name[]" class="form-control"
                                                        value="<%= module.module_name || '' %>">
                                                </td>

                                                <td>
                                                    <select name="credits[]" class="form-select">
                                                        <option valuee="">Select Credits</option>
                                                        <option value="20" <%=module.credits==20 ? 'selected' : '' %>>20
                                                        </option>
                                                        <option value="40" <%=module.credits==40 ? 'selected' : '' %>>40
                                                        </option>
                                                        <option value="60" <%=module.credits==60 ? 'selected' : '' %>>60
                                                        </option>

                                                    </select>
                                                </td>


                                            </tr>


                                            <%}%>
                                    </tbody>



                                </table>

                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-primary" id="addRowBtn">+ Add More Rows</button>
                                <button type="submit" class="btn btn-primary" name="action" value="save">Save
                                    Changes</button>
                            </div>




                        </form>


                    </div>
                </div>

            </div>



        </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        <script>

            document.getElementById('addRowBtn').addEventListener('click', function () {
                const tableBody = document.querySelector('#moduleTable tbody');
                const newRow = document.createElement('tr');

                newRow.innerHTML = `
                <input type="hidden" name="module_id[]" value="">
                <td>
            <select name="level[]" class="form-select">
                <option value="">Select Level</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
            </select>
        </td>
        <td><input type="text" name="module_code[]" class="form-control"></td>
        <td><input type="text" name="module_name[]" class="form-control"></td>
        <td>
            <select name="credits[]" class="form-select">
                <option value="">Select Credits</option>
                <option value="20">20</option>
                <option value="40">40</option>
                <option value="60">60</option>
            </select>
        </td>
        <td class="text-center">
            <button type="button" class="btn btn-primary btn-sm" onclick="this.closest('tr').remove()">x</button>
        </td>`;

        tableBody.appendChild(newRow);

            });

        </script>

</body>

</html>