<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Officer dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/ui.css">
</head>

<body>

   <%- include('partials/navbar') %>

    <div class="container-officer-info">
    <div class="row heading-container pb-1">
            <div class="row p-1 text-center">
                <h1>Welcome, <%=currentUser.first_name%></h1>
                <h2>Programme Assignments</h2>
            </div>
            <nav class="heading p-1">
                <div class="row">
                    <div class="col-md-6">
                        <div class="container-fluid">
                            <form action="/officer" method="GET" class="d-flex" role="search">
                                <input name="search" class="form-control" type="search"
                                    placeholder="Search by programme name, award type or academic year"
                                    aria-label="Search" />
                                <button class="btn btn-outline-secondary bg-secondary text-white"
                                    type="submit">Search</button>
                                    </form>
                        </div>
                    </div>
                </div>
            </nav>
        </div>

        <div class="records-row px-5">

            <div class="row">
                <% myProgrammes.forEach(item=> { %>
                    <div class="card p-2 border mb-4">
                        <div class="card-body">
                            <h5 class="card-title">
                                <%=item.award_type%>
                                    <%=item.programme_name%> (<%=item.pathway%>) - <%=item.academic_year%>
                            </h5>
                            <p class="card-text">Status: Total of <%= item.total_students %> Students</p>
                             <p class="card-text">
                                <%= item.approved_students %> / <%= item.total_students %> Students Approved ( <%= item.awaiting_students %> Awaiting Approval )
                            </p>
                            <p class="card-text">
                                <%= item.flagged_students %> Students Flagged for Manual Review
                            </p>
                            <a href="/officer/viewstudents/<%= item.id %>" class="btn btn-primary">View Student List</a>
                        </div>
                    </div>



                    <% }) %>
            </div>
        </div>
    </div>



</body>

</html>