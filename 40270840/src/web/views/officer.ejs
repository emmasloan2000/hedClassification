<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Officer dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/ui.css">
</head>

<body>

    <nav class="navbar2">
        <div class="logo-container">
            <img src="/media/logo.png" alt="Logo">
        </div>
        <div class="logout-container">
            <a href="/login" class="button">Logout</a>
        </div>
    </nav>

    <div class="button-container">
        <div class="row">
            <div class="d-grid gap-2 text-center bg-light">
                
                <h1 class="welcome fw-bold text-muted">Welcome, <%= currentUser.first_name %>
                </h1>
                <p class="assignment fw-bold text-muted">My Assignments</p>
                </div>
            
        </div>

        <div class="records-row">

            <div class="row">
                <% myProgrammes.forEach(item=> { %>
                    <div class="card p-2 border mb-4">
                        <div class="card-body">
                            <h5 class="card-title">
                                <%=item.award_type%>
                                    <%=item.programme_name%> (<%=item.pathway%>) - <%=item.academic_year%>
                            </h5>
                            <p class="card-text">Status: Total of <%= item.total_students %> Students</p>
                            <p class="card-text">
                                <%= item.flagged_students %> Students Flagged for Manual Review
                            </p>
                            <a href="/admin/viewstudents/<%= item.id %>" class="btn btn-primary">View Student List</a>
                        </div>
                    </div>
            


            <% }) %>
        </div>
    </div>
    </div>



</body>

</html>